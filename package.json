{
  "name": "alchemy-convex-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/alchemy-convex build",
    "check": "bun run --cwd packages/alchemy-convex check && bun run --cwd examples/basic check",
    "test": "bun run --cwd packages/alchemy-convex test",
    "test:watch": "bun run --cwd packages/alchemy-convex test:watch",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ci": "bun run format:check && bun run lint && bun run check && bun run test && bun run build",
    "example:plan": "bun alchemy plan examples/basic/alchemy.run.ts"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.99",
    "alchemy": "2.0.0-beta.63",
    "effect": "4.0.0-beta.99",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0"
  },
  "packageManager": "bun@1.3.14"
}
